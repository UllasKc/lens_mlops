DATABRICKS_HOST=https://...
DATABRICKS_GENIE_SPACE_ID=your_genie_space_id
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=appkit-genie
FLASK_RUN_HOST=0.0.0.0

# Lakebase (chat history + usage log) — direct endpoint host, not the "-pooler" host
PGHOST=ep-xxxxxxxx.database.us-east-2.cloud.databricks.com
PGDATABASE=chatapp
PGPORT=5432
PGSSLMODE=require
LAKEBASE_ENDPOINT=projects/your-project/branches/production/endpoints/primary
